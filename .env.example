# === Google Docs Publisher ===
GOOGLE_SERVICE_ACCOUNT_PATH=./service_account.json
GOOGLE_DOC_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Bancos opcionais (Homelab) ===
# Dois formatos aceitos:
#   postgresql://usuario:senha@host:5432/banco
#   docker://<container>/<banco>?user=<usuario>   (roda `docker exec ... psql` na mesma máquina; sem senha)
# Ex.: KANBN_DATABASE_URL=docker://kanbn-postgres-1/kan_db?user=kan
KANBN_DATABASE_URL=
SECURO_DATABASE_URL=
UMAMI_DATABASE_URL=
